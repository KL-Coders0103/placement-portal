# ─────────────────────────────────────────────────────────────
# Placement Portal — Environment Template
# Copy to `.env` and fill local-only values.
# NEVER commit a populated .env file.
# ─────────────────────────────────────────────────────────────

# ── Shared ───────────────────────────────────────────────────
NODE_ENV=development

# ── API (apps/api) ───────────────────────────────────────────
PORT=3000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173

# MongoDB — local replica set (via infra/docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/placementPortal?replicaSet=rs0&directConnection=true

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets — generate with `openssl rand -hex 32` for local dev
# DO NOT reuse these values in any other environment.
ACCESS_TOKEN_SECRET=change-me-local-dev-only-access
REFRESH_TOKEN_SECRET=change-me-local-dev-only-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Private object storage (MinIO locally)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=placement-portal-private
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Email provider (placeholder until OPEN-012 is decided)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@placement-portal.local

# Logging
LOG_LEVEL=debug

# ── Worker (apps/worker) ─────────────────────────────────────
WORKER_CONCURRENCY=5

# ── Web (apps/web) ───────────────────────────────────────────
# Only VITE_* variables are exposed to the browser bundle.
# NEVER put secrets here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_ENV=development